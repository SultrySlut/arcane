--[[
	CARGO GRAB CHECK  -  "is it safe to grab this sealed chest right now?"
	------------------------------------------------------------------
	The server runs an anti-cheat check called CargoSpeedsBroken every time
	you pick up or hand in cargo:
	    CheckAction(player, bin.LastCargo, bin.LastCargoOpened,
	                yourPosition, "CargoSpeedsBroken", yourPing)
	i.e. it compares WHERE/WHEN your last cargo action was with WHERE you are
	now. Grab a chest somewhere you couldn't have reached at legit speed since
	your last cargo action and it flags you. Selling also has a hard 1s gap.

	This script puts an indicator on every sealed chest in range (same style
	as the SirenRock detector) that says OK / WAIT xs / too far, and a small
	HUD with the numbers behind it.

	It reads the server's own LastCargo / LastCargoOpened values from
	Player.bin when they replicate; otherwise it tracks your cargo actions
	itself (pickups, drops and sales), which is stricter, never looser.

	Unload: getgenv().CargoCheckStop()
--]]

local Players    = game:GetService("Players")
local Workspace  = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local RS         = game:GetService("ReplicatedStorage")
local LP         = Players.LocalPlayer

-- ================= CONFIG =================
local DETECTION_RANGE  = 20000   -- studs: chests further than this get no indicator
local UPDATE_RATE      = 0.5     -- rescan for chests
local TEXT_RATE        = 0.1     -- refresh the numbers
local PICKUP_RANGE     = 30      -- server: must be within 30 studs of the chest to pick it up

-- The server's real threshold lives in a server-only module (ExploitLogs, a
-- Discord webhook logger) so it can't be read. What CAN be read is the
-- fastest LEGIT travel, which the threshold must sit above:
--   ship base speeds  30 / 50 / 60 / 70 (Brig) / 75 (The Omen)
--   + sail material    up to ~+25 (tester cloth is +35)
--   + sail enchant     Swift +10, Brisk +15, Warship +25
--   => a maxed player ship is ~120 studs/s
-- Community data puts a fully kitted ship (deckhands + hull + ram + sail)
-- at ~150. Observed routine (vfly to ring 3 + 5 min wait, then grabbing
-- clean) works out to ~170 seen by the server. 165 sits just under that.
local MAX_SAFE_SPEED   = 165     -- starting value; the HUD +/- buttons change it live and it's saved
local LIMIT_STEP       = 10      -- +/- step
local LOG_FILE         = "CargoCheck/grabs.json"   -- every grab: distance, elapsed, implied speed
local SETTINGS_FILE    = "CargoCheck/settings.json"
local MIN_GAP          = 1.5     -- seconds: hard floor between cargo actions (server uses 1s on sells)
local PING_ALLOWANCE   = 0.5     -- seconds of slack for ping / server tick

local CHEST_FOLDER     = { "Map", "Temporary" }
-- ==========================================

if getgenv().CargoCheckRunning then
	if getgenv().CargoCheckStop then getgenv().CargoCheckStop() end
end
getgenv().CargoCheckRunning = true

local conns = {}
local function track(c) table.insert(conns, c); return c end
local function walk(root, path)
	local n = root
	for _, k in ipairs(path) do n = n and n:FindFirstChild(k) end
	return n
end
local function myHRP()
	local ch = LP.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end

-- ================= CLOCK =================
-- The server stamps bin.LastCargoOpened with ITS tick(). On the client tick()
-- is timezone-shifted (hours off), so we compare against the server clock.
local function serverNow()
	local ok, t = pcall(function() return Workspace:GetServerTimeNow() end)
	if ok and type(t) == "number" and t > 0 then return t end
	return os.time()
end

-- ================= LAST CARGO ACTION =================
-- selfPos/selfTime: our own tracking. serverPos/serverTime: Player.bin if it replicates.
local last = { pos = nil, time = 0, source = "none" }
local MAX_SANE_AGE = 6 * 3600   -- older than this (or in the future) = ignore the server value

local function binValues()
	local bin = LP:FindFirstChild("bin")
	if not bin then return nil end
	local p = bin:FindFirstChild("LastCargo")
	local t = bin:FindFirstChild("LastCargoOpened")
	if p and t and p:IsA("Vector3Value") and t:IsA("NumberValue") then return p, t end
	return nil
end

-- ================= PERSISTENCE (limit + grab log) =================
local HttpService = game:GetService("HttpService")
local hasFS = typeof(isfile) == "function" and typeof(writefile) == "function" and typeof(readfile) == "function"
local function readJSON(path)
	if not hasFS or not isfile(path) then return nil end
	local ok, d = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	return ok and d or nil
end
local function writeJSON(path, data)
	if not hasFS then return end
	pcall(function()
		if typeof(makefolder) == "function" and typeof(isfolder) == "function" and not isfolder("CargoCheck") then makefolder("CargoCheck") end
		writefile(path, HttpService:JSONEncode(data))
	end)
end
do
	local st = readJSON(SETTINGS_FILE)
	if st and tonumber(st.limit) then MAX_SAFE_SPEED = tonumber(st.limit) end
end
local function saveSettings() writeJSON(SETTINGS_FILE, { limit = MAX_SAFE_SPEED }) end

-- grab log: one entry per pickup with the numbers the server sees
local grabLog = readJSON(LOG_FILE) or {}
local stats = { grabs = 0, maxSpeed = 0 }     -- this session
for _, g in ipairs(grabLog) do
	if type(g.speed) == "number" and g.speed > stats.maxSpeed and g.speed < 1e6 then stats.maxSpeed = g.speed end
end
local function logGrab(dist, elapsed, speed)
	stats.grabs = stats.grabs + 1
	if speed < 1e6 and speed > stats.maxSpeed then stats.maxSpeed = speed end
	table.insert(grabLog, { t = os.time(), dist = math.floor(dist), elapsed = math.floor(elapsed * 10) / 10,
		speed = math.floor(speed * 10) / 10, limit = MAX_SAFE_SPEED })
	if #grabLog > 500 then table.remove(grabLog, 1) end
	writeJSON(LOG_FILE, grabLog)
	print(("[CargoCheck] GRAB  dist %.0f  elapsed %.1fs  implied %.0f st/s  (limit %d)"):format(dist, elapsed, speed, MAX_SAFE_SPEED))
end

local lastPickupAt = 0
local function markAction(reason)
	local hrp = myHRP()
	if not hrp then return end
	-- the same pickup is seen twice (Carrying value + Carry remote): count it once
	if reason == "pickup" then
		if serverNow() - lastPickupAt < 1 then return end
		lastPickupAt = serverNow()
	end
	-- a pickup is the moment the server runs its check: record what it saw
	if reason == "pickup" and last.pos then
		local elapsed = math.max(0, serverNow() - last.time)
		local dist = (hrp.Position - last.pos).Magnitude
		local speed = elapsed > 0 and dist / elapsed or math.huge
		logGrab(dist, elapsed, speed)
	end
	last.pos, last.time, last.source = hrp.Position, serverNow(), reason
	print(("[CargoCheck] cargo action: %s at %.0f,%.0f,%.0f"):format(reason, hrp.Position.X, hrp.Position.Y, hrp.Position.Z))
end

-- prefer the server's values if visible AND sane
local function refreshLast()
	local p, t = binValues()
	if not (p and t) then return end
	local pos, stamp = p.Value, t.Value
	if stamp <= 0 or pos == Vector3.zero then return end       -- never sold/picked up yet
	local age = serverNow() - stamp
	if age < -5 or age > MAX_SANE_AGE then return end           -- clock mismatch / stale: ignore
	-- take the server value only if it's newer than what we tracked ourselves
	if stamp >= last.time then
		last.pos, last.time, last.source = pos, stamp, "server"
	end
end

-- watch our character for the Carrying value (pickup) and its removal (drop/sell)
local function hookCharacter(ch)
	track(ch.ChildAdded:Connect(function(c)
		if c.Name == "Carrying" or c.Name == "Carrying2" then markAction("pickup") end
	end))
	track(ch.ChildRemoved:Connect(function(c)
		if c.Name == "Carrying" or c.Name == "Carrying2" then markAction("drop/sell") end
	end))
end
if LP.Character then hookCharacter(LP.Character) end
track(LP.CharacterAdded:Connect(hookCharacter))

-- the Carry remote fires to everyone on pickup (false) / place (true)
do
	local misc = walk(RS, { "RS", "Remotes", "Misc" })
	local carry = misc and misc:FindFirstChild("Carry")
	if carry and carry:IsA("RemoteEvent") then
		track(carry.OnClientEvent:Connect(function(part, placed)
			if typeof(part) ~= "Instance" then return end
			task.delay(0.1, function()
				local carrier = part:FindFirstChild("Carrier")
				if carrier and carrier.Value == LP.Name then
					markAction(placed and "placed" or "pickup")
				end
			end)
		end))
	end
end

-- ================= THE VERDICT =================
-- Returns: ok(bool), waitSeconds, impliedSpeed, elapsed, dist
local function fmtWait(sec)
	if sec >= 3600 then return ("%.1fh"):format(sec / 3600) end
	if sec >= 90 then return ("%dm %02ds"):format(math.floor(sec / 60), math.floor(sec % 60)) end
	return ("%.1fs"):format(sec)
end

local function verdictAt(targetPos)
	refreshLast()
	local now = serverNow()
	if not last.pos then
		return true, 0, 0, math.huge, 0            -- no previous action known
	end
	local elapsed = now - last.time
	if elapsed < 0 then elapsed = 0 end            -- never trust a negative gap
	local dist = (targetPos - last.pos).Magnitude
	-- time the server would consider "enough" to cover that distance
	local needed = math.max(MIN_GAP, dist / MAX_SAFE_SPEED + PING_ALLOWANCE)
	local wait = needed - elapsed
	local speed = elapsed > 0 and (dist / elapsed) or math.huge
	return wait <= 0, math.max(0, wait), speed, elapsed, dist
end

-- ================= UI (same style as the SirenRock detector) =================
local tracked = {}   -- chest -> {Gui, IconText, StatusText}

local function isSealedChest(inst)
	return inst:IsA("BasePart") and inst:FindFirstChild("IsSealedChest") ~= nil
end

local function makeIndicator(chest)
	local existing = chest:FindFirstChild("CargoCheckIndicator")
	if existing then existing:Destroy() end

	local gui = Instance.new("BillboardGui")
	gui.Name = "CargoCheckIndicator"
	gui.Size = UDim2.new(0, 220, 0, 100)
	gui.StudsOffset = Vector3.new(0, 6, 0)
	gui.AlwaysOnTop = true
	gui.Parent = chest

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundTransparency = 0.3
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	frame.BorderSizePixel = 0
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local icon = Instance.new("TextLabel")
	icon.Name = "IconText"
	icon.Size = UDim2.new(1, 0, 0.4, 0)
	icon.Position = UDim2.new(0, 0, 0, 5)
	icon.BackgroundTransparency = 1
	icon.Text = "📦 " .. chest.Name:upper()
	icon.TextColor3 = Color3.fromRGB(255, 200, 100)
	icon.TextScaled = true
	icon.Font = Enum.Font.SourceSansBold
	icon.Parent = frame

	local status = Instance.new("TextLabel")
	status.Name = "StatusText"
	status.Size = UDim2.new(1, 0, 0.5, 0)
	status.Position = UDim2.new(0, 0, 0.4, 0)
	status.BackgroundTransparency = 1
	status.Text = "..."
	status.TextColor3 = Color3.fromRGB(255, 255, 255)
	status.TextScaled = true
	status.Font = Enum.Font.SourceSans
	status.Parent = frame

	return { Gui = gui, IconText = icon, StatusText = status }
end

-- HUD (top-left) with the numbers behind the verdict
local hud
do
	local parent = game:GetService("CoreGui")
	pcall(function() if typeof(gethui) == "function" then parent = gethui() end end)
	local old = parent:FindFirstChild("CargoCheckHUD")
	if old then old:Destroy() end
	local sg = Instance.new("ScreenGui")
	sg.Name = "CargoCheckHUD"
	sg.ResetOnSpawn = false
	sg.Parent = parent
	local f = Instance.new("Frame")
	f.Size = UDim2.new(0, 280, 0, 118)
	f.Position = UDim2.new(0, 12, 0, 120)
	f.BackgroundTransparency = 0.3
	f.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	f.BorderSizePixel = 0
	f.Parent = sg
	Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
	local t1 = Instance.new("TextLabel")
	t1.Size = UDim2.new(1, -12, 0, 26); t1.Position = UDim2.new(0, 6, 0, 4)
	t1.BackgroundTransparency = 1; t1.Font = Enum.Font.SourceSansBold; t1.TextScaled = true
	t1.TextXAlignment = Enum.TextXAlignment.Left; t1.TextColor3 = Color3.fromRGB(255, 200, 100)
	t1.Text = "CARGO CHECK"; t1.Parent = f
	local t2 = Instance.new("TextLabel")
	t2.Size = UDim2.new(1, -12, 0, 40); t2.Position = UDim2.new(0, 6, 0, 30)
	t2.BackgroundTransparency = 1; t2.Font = Enum.Font.SourceSans; t2.TextSize = 14
	t2.TextXAlignment = Enum.TextXAlignment.Left; t2.TextYAlignment = Enum.TextYAlignment.Top
	t2.TextColor3 = Color3.fromRGB(230, 230, 230); t2.TextWrapped = true
	t2.Text = "no cargo action yet"; t2.Parent = f
	-- limit row: [-] limit [+]
	local function small(txt, x)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0, 28, 0, 22); b.Position = UDim2.new(0, x, 0, 90)
		b.BackgroundColor3 = Color3.fromRGB(60, 60, 68); b.BorderSizePixel = 0
		b.Text = txt; b.TextColor3 = Color3.fromRGB(235, 235, 240); b.TextSize = 16; b.Font = Enum.Font.SourceSansBold
		b.Parent = f; Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
		return b
	end
	local minus = small("-", 6)
	local plus  = small("+", 40)
	local lim = Instance.new("TextLabel")
	lim.Size = UDim2.new(1, -80, 0, 22); lim.Position = UDim2.new(0, 74, 0, 90)
	lim.BackgroundTransparency = 1; lim.Font = Enum.Font.SourceSans; lim.TextSize = 14
	lim.TextXAlignment = Enum.TextXAlignment.Left; lim.TextColor3 = Color3.fromRGB(230, 230, 230)
	lim.Text = ""; lim.Parent = f
	minus.MouseButton1Click:Connect(function() MAX_SAFE_SPEED = math.max(10, MAX_SAFE_SPEED - LIMIT_STEP); saveSettings() end)
	plus.MouseButton1Click:Connect(function() MAX_SAFE_SPEED = MAX_SAFE_SPEED + LIMIT_STEP; saveSettings() end)
	hud = { gui = sg, title = t1, body = t2, limit = lim }
end

-- ================= LOOPS =================
local function chestFolder() return walk(Workspace, CHEST_FOLDER) end

local function scan()
	local hrp = myHRP()
	if not hrp then return end
	local folder = chestFolder()
	if not folder then return end
	local seen = {}
	for _, c in ipairs(folder:GetChildren()) do
		if isSealedChest(c) then
			local d = (c.Position - hrp.Position).Magnitude
			if d <= DETECTION_RANGE then
				seen[c] = true
				if not tracked[c] or not tracked[c].Gui.Parent then
					tracked[c] = makeIndicator(c)
				end
			end
		end
	end
	for c, ind in pairs(tracked) do
		if not seen[c] or not c.Parent then
			pcall(function() ind.Gui:Destroy() end)
			tracked[c] = nil
		end
	end
end

local function updateText()
	local hrp = myHRP()
	if not hrp then return end
	local me = hrp.Position

	-- HUD: verdict for grabbing something right where you stand
	do
		local ok, wait, speed, elapsed, dist = verdictAt(me)
		if not last.pos then
			hud.body.Text = "no cargo action recorded yet\nfirst grab is always OK"
			hud.title.TextColor3 = Color3.fromRGB(100, 255, 100)
		else
			hud.title.TextColor3 = ok and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
			hud.body.Text = string.format(
				"last action: %s, %s ago, %.0f studs away\nimplied here %.0f st/s  %s",
				last.source, fmtWait(elapsed), dist, speed == math.huge and 0 or speed,
				ok and "OK HERE" or ("WAIT " .. fmtWait(wait)))
		end
	end

	if hud.limit then
		hud.limit.Text = string.format("limit %d st/s   grabs %d   fastest ok %.0f",
			MAX_SAFE_SPEED, #grabLog, stats.maxSpeed)
	end
	-- share the verdict-at-my-position with other scripts (vfly panel shows it)
	do
		local ok, wait = verdictAt(me)
		getgenv().CargoCheckState = { ok = ok, wait = wait, limit = MAX_SAFE_SPEED, t = tick() }
	end

	-- per-chest indicators
	for chest, ind in pairs(tracked) do
		if chest.Parent and ind.Gui.Parent then
			local d = (chest.Position - me).Magnitude
			local carrier = chest:FindFirstChild("Carrier")
			local held = carrier and carrier.Value ~= "" and carrier.Value or nil
			local ok, wait = verdictAt(chest.Position)

			local text, col
			if held == LP.Name then
				text, col = "CARRYING", Color3.fromRGB(150, 200, 255)
			elseif held then
				text, col = "held by " .. held, Color3.fromRGB(200, 200, 200)
			elseif not ok then
				text, col = ("⛔ WAIT %s  ·  %d studs"):format(fmtWait(wait), d), Color3.fromRGB(255, 90, 90)
			elseif d > PICKUP_RANGE then
				text, col = ("✅ OK  ·  %d studs (get <%d)"):format(d, PICKUP_RANGE), Color3.fromRGB(255, 230, 120)
			else
				text, col = ("✅ GRAB NOW  ·  %d studs"):format(d), Color3.fromRGB(100, 255, 100)
			end
			ind.StatusText.Text = text
			ind.StatusText.TextColor3 = col
		end
	end
end

local running = true
task.spawn(function()
	while running do pcall(scan); task.wait(UPDATE_RATE) end
end)
task.spawn(function()
	while running do pcall(updateText); task.wait(TEXT_RATE) end
end)

getgenv().CargoCheckStop = function()
	running = false
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	conns = {}
	for _, ind in pairs(tracked) do pcall(function() ind.Gui:Destroy() end) end
	tracked = {}
	if hud then pcall(function() hud.gui:Destroy() end) end
	getgenv().CargoCheckRunning = false
end

pcall(function()
	StarterGui:SetCore("SendNotification", {
		Title = "Cargo Check Active",
		Text = "Sealed chests show OK / WAIT before you grab",
		Duration = 3,
	})
end)
print("[CargoCheck] started - speed limit " .. MAX_SAFE_SPEED .. " st/s, min gap " .. MIN_GAP .. "s")
